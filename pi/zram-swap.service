[Unit]
Description=zram swap (256M lz4)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'modprobe zram; echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null; echo 256M > /sys/block/zram0/disksize; mkswap /dev/zram0; swapon -p 100 /dev/zram0'
ExecStop=/sbin/swapoff /dev/zram0

[Install]
WantedBy=multi-user.target
